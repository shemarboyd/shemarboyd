<#
.SYNOPSIS
    This PowerShell script sets the AlwaysInstallElevated to 0 so there isnt full admin rights during a MSI install.
.NOTES
    Author          : Shemar Boyd
    LinkedIn        : https://www.linkedin.com/in/shemar-boyd-a23388150/
    GitHub          : github.com/shemarboyd
    Date Created    : 2026-03-26
    Last Modified   : 2026-03-26
    Version         : 1.0
    CVEs            : N/A
    Plugin IDs      : N/A
    STIG-ID         : WN11-CC-000315

.TESTED ON
    Date(s) Tested  : 3/27/2026
    Tested By       : shemarboyd
    Systems Tested  : Windows 11 vm
    PowerShell Ver. : 5.1.26100.7920

.USAGE
    Put any usage instructions here.
    Example syntax:
    PS C:\> .\__remediation_template(STIG-ID-WN11-CC-000315).ps1 
#>

$registryPath = 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\Installer'
$name = 'AlwaysInstallElevated'
$value = 0

# Create the key if it does not exist
if (-not (Test-Path -Path $registryPath)) {
    New-Item -Path $registryPath -Force | Out-Null
}

# Create or update the DWORD value
New-ItemProperty -Path $registryPath `
    -Name $name `
    -Value $value `
    -PropertyType DWord `
    -Force | Out-Null

# Verify the setting
Get-ItemProperty -Path $registryPath -Name $name
